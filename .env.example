# Bharat Biz-Agent Configuration
# Copy this file to .env and fill in your actual values

# WhatsApp Cloud API Configuration
# Get these from Meta Business Developer Portal: https://developers.facebook.com/
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here
WHATSAPP_TOKEN=your_whatsapp_permanent_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Authorization (For Hackathon Demo)
# Your phone number (business owner)
BUSINESS_OWNER_PHONE=+919876543210

# Judges/testers phone numbers (comma-separated, max 5 for Meta free tier)
AUTHORIZED_TEST_PHONES=+919988776655,+919123456789,+919111111111,+919222222222

# Note: In production, this would be replaced with multi-tenant database lookup
# See MULTI_USER_ARCHITECTURE.md for production implementation

# Optional: If you want to use Firebase/Supabase for cloud backup
# FIREBASE_CONFIG_JSON=path_to_firebase_config.json
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_key
