# Mera Business — Environment Configuration
# ─────────────────────────────────────────────────────────────
# SETUP:  cp .env.example .env
#         Then fill in your real values and save.
#         ⚠️  NEVER commit .env to git — it contains secrets!
# ─────────────────────────────────────────────────────────────

# ── WhatsApp Cloud API ────────────────────────────────────────
# Get from: https://developers.facebook.com → My Apps → WhatsApp → API Setup
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string_here
WHATSAPP_TOKEN=your_permanent_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# ── Google Gemini AI ──────────────────────────────────────────
# Get FREE key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Authorization (who can message the bot) ──────────────────
# Your own WhatsApp number (with country code, no spaces)
BUSINESS_OWNER_PHONE=+91XXXXXXXXXX

# Additional testers/judges (comma-separated, max 5 on Meta free tier)
AUTHORIZED_TEST_PHONES=+91XXXXXXXXXX,+91XXXXXXXXXX

# ── Business Info (printed on PDF invoices) ──────────────────
BUSINESS_NAME=Your Shop Name
BUSINESS_ADDRESS=Your Shop Address, City - XXXXXX
BUSINESS_PHONE=+91XXXXXXXXXX
BUSINESS_EMAIL=your@email.com
BUSINESS_GSTIN=YOUR_GSTIN_HERE

# ── Optional: PDF output directory ───────────────────────────
# PDF_OUTPUT_DIR=./invoices

# ── Optional: Cloud DB backup ────────────────────────────────
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_anon_key
